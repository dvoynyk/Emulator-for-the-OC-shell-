# Полное тестирование функциональности

# Простые команды
ls
cd /

# Команды с аргументами
ls file1.txt file2.txt
cd "Program Files"

# Команды с одинарными кавычками
ls 'my folder'

# Смешанные кавычки
ls "file 1" 'file 2' file3

# Проверка ошибки
wrong_cmd

# Продолжение после ошибки
cd /home
ls -l